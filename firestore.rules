rules_version = '2';
// DEVELOPMENT RULES for the SHEIN training task.
// Open on purpose: the app seeds demo products anonymously at startup.
// Tighten before any real deployment (require request.auth != null for writes).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
